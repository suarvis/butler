<?xml version="1.0" encoding="UTF-8"?>
<!--
  stdout belongs to command output (including the JSON contract), so logs go to stderr only.
  BUTLER_LOG_LEVEL raises verbosity, e.g. BUTLER_LOG_LEVEL=DEBUG butler status.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${BUTLER_LOG_LEVEL:-WARN}">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
